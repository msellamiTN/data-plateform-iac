# Encoding & line-ending policy
# .ps1 = UTF-8 with BOM + CRLF (Windows PowerShell 5.1 decodes UTF-8 correctly only with BOM)
# .sh/.tf/.md/.yml = UTF-8 without BOM + LF
* text=auto

*.md         text eol=lf
*.tf         text eol=lf
*.hcl        text eol=lf
*.tfvars     text eol=lf
*.sh         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.sql        text eol=lf
*.ps1        text eol=crlf
*.psm1       text eol=crlf
*.bat        text eol=crlf
*.cmd        text eol=crlf

*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.docx       binary
*.pdf        binary
*.exe        binary
*.zip        binary
